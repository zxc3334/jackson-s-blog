---
import type { Post } from '../lib/posts';
import { formatDate, makeExcerpt, postPath, readingTime, tagPath } from '../lib/posts';

interface Props {
	posts: Post[];
	showExcerpt?: boolean;
}

const { posts, showExcerpt = false } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a class="post-title" href={postPath(post)}>{post.data.title}</a>
				<span class="post-date">
					<time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
					· {readingTime(post.body ?? '')}
				</span>
				{showExcerpt && makeExcerpt(post) && <p class="post-excerpt">{makeExcerpt(post)}</p>}
				<ul class="tag-list">
					{post.data.tags.map((tag) => (
						<li>
							<a href={tagPath(tag)}>{tag}</a>
						</li>
					))}
				</ul>
			</li>
		))
	}
</ul>
{
	posts.length === 0 && (
		<p class="post-excerpt">
			暂无文章。在 <code>content/</code> 目录新增一篇 Markdown 即可开始写作。
		</p>
	)
}
