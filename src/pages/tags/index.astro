---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts, tagPath } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览全部文章">
	<h1>标签</h1>
	<p class="page-intro">共 {tags.length} 个标签。</p>
	<ul class="tag-index">
		{
			tags.map((tag) => (
				<li>
					<a href={tagPath(tag.name)}>
						{tag.name}
						<span class="tag-count">{tag.count}</span>
					</a>
				</li>
			))
		}
	</ul>
	{tags.length === 0 && <p class="post-excerpt">暂无标签。</p>}
</BaseLayout>
